{
  "name": "notetoo",
  "productName": "NoteTOO",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sample": "node scripts/make-sample.mjs",
    "server:compile": "tsc -p server",
    "server": "npm run build -- --logLevel error && npm run server:compile && node out/server/main.mjs",
    "desktop:compile": "tsc -p electron",
    "desktop:dev": "npm run desktop:compile && node scripts/desktop-dev.mjs",
    "desktop": "npm run build && npm run desktop:compile && electron .",
    "dist:win": "npm run build && npm run desktop:compile && electron-builder --win --x64",
    "updater:compile": "tsc -p updater",
    "updater:build": "vite build --config updater/vite.config.ts && npm run updater:compile",
    "updater:dev": "npm run updater:compile && node scripts/updater-dev.mjs",
    "dist:updater": "npm run updater:build && electron-builder --config updater/electron-builder.json --win --x64",
    "release:sign": "node scripts/release/sign.mjs",
    "release:publish": "node scripts/release/publish.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "description": "Organize, preview and annotate your school files.",
  "main": "out/electron/main.mjs",
  "author": "NoteTOO",
  "build": {
    "appId": "com.notetoo.desktop",
    "productName": "NoteTOO",
    "copyright": "NoteTOO",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "out/electron/**/*",
      "out/src/fs/paths.js",
      "electron/receive-page.html",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "NoteTOO"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoteTOO",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "NoteTOO-Setup-${version}.${ext}"
    }
  }
}
