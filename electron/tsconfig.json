{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../out"
  },
  "include": ["*.mts", "*.cts", "../src/desktop/bridge.ts"],
  "exclude": ["*.test.ts"]
}
